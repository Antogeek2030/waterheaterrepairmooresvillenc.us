---
import { services } from '../data/services';
import { areas } from '../data/areas';

const topServices = services.slice(0, 6);
const topAreas = areas.slice(0, 6);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>Water Heater Repair Mooresville NC</h3>
        <p>
          Professional water heater repair, installation, and maintenance serving Mooresville
          and surrounding Lake Norman communities.
        </p>
        <p>
          <strong>Address:</strong><br />
          124 Lakeshore Dr<br />
          Mooresville, NC 28117
        </p>
        <p>
          <strong>Phone:</strong>
          <a href="tel:+17045550123">(704) 555-0123</a>
        </p>
      </div>

      <div class="footer-col">
        <h4>Popular Services</h4>
        <ul>
          {topServices.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>
          ))}
          <li><a href="/services/">View all services</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Service Areas</h4>
        <ul>
          {topAreas.map((a) => (
            <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>
          ))}
          <li><a href="/areas/">All areas</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {new Date().getFullYear()} Water Heater Repair Mooresville NC. All rights reserved.
        Serving Mooresville, Lake Norman, and nearby communities.
      </p>
    </div>
  </div>
</footer>
