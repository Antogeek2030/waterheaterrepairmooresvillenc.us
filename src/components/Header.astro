---
import { services } from '../data/services';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Water Heater Repair Mooresville NC home">
      Water Heater Repair
      <span>Mooresville, NC</span>
    </a>

    <button
      class="nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="main-navigation" aria-label="Main">
      <a href="/">Home</a>
      <div class="dropdown">
        <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
          Services
          <span aria-hidden="true">▾</span>
        </button>
        <div class="dropdown-menu" role="menu">
          <a href="/services/" role="menuitem">All Services</a>
          {services.map((s) => (
            <a href={`/services/${s.slug}/`} role="menuitem">{s.title}</a>
          ))}
        </div>
      </div>
      <a href="/areas/">Service Areas</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blog</a>
      <a href="/contact/">Contact</a>
      <a href="tel:+17045550123" class="btn btn-primary nav-cta">Call (704) 555-0123</a>
    </nav>
  </div>
</header>
