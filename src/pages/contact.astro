---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Water Heater Repair Mooresville NC"
  description="Contact our Mooresville water heater team for repair, installation, or maintenance. Call or use the form to request service."
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>Contact</span>
      </nav>
      <h1>Contact Us</h1>
      <p>
        Reach out for service in Mooresville and the surrounding Lake Norman area.
        We respond as quickly as we can.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <h2>Get in Touch</h2>
          <p>
            <strong>Phone:</strong>
            <a href="tel:+17045550123">(704) 555-0123</a>
          </p>
          <p>
            <strong>Address:</strong><br />
            124 Lakeshore Dr<br />
            Mooresville, NC 28117, USA
          </p>
          <p>
            Prefer to write? Use the form and we will get back to you. For urgent no-hot-water
            situations, calling is usually fastest.
          </p>
        </div>

        <div>
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            id="contact-form"
            aria-label="Contact form"
          >
            <!-- Replace with your Web3Forms access key -->
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
            <input type="hidden" name="subject" value="New service request from website" />
            <input type="hidden" name="from_name" value="Water Heater Repair Mooresville" />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />

            <div class="form-group">
              <label for="name">Name <span aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="phone">Phone <span aria-hidden="true">*</span></label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" />
            </div>

            <div class="form-group">
              <label for="service">Service Needed</label>
              <select id="service" name="service">
                <option value="">Select an option</option>
                <option value="Repair">Water Heater Repair</option>
                <option value="Installation">Installation / Replacement</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Emergency">Emergency / No Hot Water</option>
                <option value="Other">Other / Not Sure</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" required placeholder="Describe the issue or what you need help with..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Send Message</button>
          </form>

          <div id="form-success" hidden style="margin-top: 1.5rem; padding: 1.25rem; background: #ecfdf5; border: 1px solid #6ee7b7; border-radius: 0.5rem;">
            <strong>Thank you!</strong> Your message has been sent. We will get back to you soon.
          </div>
          <div id="form-error" hidden style="margin-top: 1.5rem; padding: 1.25rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 0.5rem;">
            Something went wrong. Please try again or call us directly.
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (success) success.hidden = true;
        if (errorEl) errorEl.hidden = true;

        const formData = new FormData(form);
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });
          const data = await res.json();
          if (data.success) {
            form.hidden = true;
            if (success) success.hidden = false;
          } else {
            if (errorEl) errorEl.hidden = false;
          }
        } catch {
          if (errorEl) errorEl.hidden = false;
        }
      });
    }
  </script>
</BaseLayout>
